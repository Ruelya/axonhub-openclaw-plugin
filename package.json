{
  "name": "@ruelya/axonhub-openclaw-plugin",
  "version": "1.0.7",
  "private": false,
  "description": "AxonHub AI Gateway provider plugin for OpenClaw - Route requests to 100+ LLM providers",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.ts",
    "*.json",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:manifest": "node -e \"JSON.parse(require('node:fs').readFileSync('openclaw.plugin.json','utf8')); console.log('openclaw.plugin.json OK')\"",
    "test:reasoning-profile": "node test/reasoning-profile.test.mjs",
    "test:e2e": "node test/family-table-e2e.test.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.29"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.4.29",
      "minGatewayVersion": "2026.4.29"
    },
    "build": {
      "openclawVersion": "2026.4.29",
      "pluginSdkVersion": "2026.4.29"
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "provider",
    "ai",
    "llm",
    "axonhub",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruelya/axonhub-openclaw-plugin.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
