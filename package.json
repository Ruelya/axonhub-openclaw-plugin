{
  "name": "@ruelya/axonhub-openclaw-plugin",
  "version": "1.2.1",
  "private": false,
  "description": "AxonHub AI Gateway provider plugin for OpenClaw - Route requests to 100+ LLM providers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "openclaw.plugin.json",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "validate:manifest": "node -e \"JSON.parse(require('node:fs').readFileSync('openclaw.plugin.json','utf8')); console.log('openclaw.plugin.json OK')\"",
    "sync:model-metadata": "node scripts/sync-model-metadata.mjs",
    "check:model-metadata": "node scripts/sync-model-metadata.mjs --check",
    "test:reasoning-profile": "node test/reasoning-profile.test.mjs",
    "test:model-routing": "node test/model-routing.test.mjs",
    "test:model-sync": "node test/model-sync.test.mjs",
    "test:codex-runtime": "node test/codex-runtime.test.mjs",
    "test:codex-toml": "node test/codex-toml.test.mjs",
    "test:codex-provider-id": "node test/codex-provider-id.test.mjs",
    "test:codex-auth-helper": "node test/codex-auth-helper.test.mjs",
    "test:codex-bridge": "node test/codex-bridge.test.mjs",
    "test:e2e": "node test/family-table-e2e.test.mjs",
    "test:all": "node --test test/*.test.mjs",
    "test": "node --test test/model-routing.test.mjs test/reasoning-profile.test.mjs test/model-sync.test.mjs test/codex-runtime.test.mjs test/codex-provider-id.test.mjs test/codex-toml.test.mjs test/codex-auth-helper.test.mjs test/codex-bridge.test.mjs test/family-table-e2e.test.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "^2026.6.8",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "axonhub"
    ],
    "compat": {
      "pluginApi": ">=2026.6.8",
      "minGatewayVersion": "2026.6.8"
    },
    "build": {
      "openclawVersion": "2026.6.8",
      "pluginSdkVersion": "2026.6.8"
    }
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "provider",
    "ai",
    "llm",
    "axonhub",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruelya/axonhub-openclaw-plugin.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
